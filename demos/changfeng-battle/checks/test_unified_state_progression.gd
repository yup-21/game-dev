extends SceneTree
## Deterministic contract: one state engine for status, technique and progression.
const Model=preload("res://scripts/battle_model.gd")
const Session=preload("res://scripts/game_session.gd")
var failures: int=0

func _initialize() -> void:
	call_deferred("_run")

func check(ok: bool,label: String) -> void:
	if not ok:
		failures+=1
		push_error("FAIL: "+label)
	else: print("PASS: "+label)

func _run() -> void:
	var m=Model.new()
	check(m.state.outcome=="playing","existing default encounter loads")
	var a=m.state.get_actor(0)
	check(a.base_max_hp_u==200000 and a.max_hp_u==200000 and a.hp_u==200000,"initial three-layer health")
	check(m.statuses.valid_definition(m.cards.statuses.meridian_wound),"declarative wound definition validates")
	check(not m.statuses.valid_definition({"id":"bad","modifiers":[{"stat":"nonexistent","value":1}]}),"unknown modifier rejected")
	check(m.statuses.add(0,"meridian_wound"),"permanent wound applies")
	check(a.base_max_hp_u==200000 and a.max_hp_u==180000,"wound modifies only effective HP limit")
	check(a.effective_attributes.AGI==9 and a.attributes.AGI==10,"effective agility does not overwrite permanent agility")
	a.hp_u=90000
	check(m.statuses.add(0,"meridian_wound"),"wound stacks")
	check(a.base_max_hp_u==200000 and a.max_hp_u==160000 and a.hp_u==90000,"multiple wounds preserve actual HP")
	m.statuses.remove(0,"meridian_wound")
	check(a.max_hp_u==200000 and a.hp_u==90000 and a.effective_attributes.AGI==10,"healing restores cap but does not heal current HP")
	check(m.statuses.add(0,"fleet_step"),"timed buff registered")
	check(a.effective_attributes.AGI==12 and a.stats.charge_speed>100,"timed buff changes agility and CTB speed")
	a.gauge=4200
	m.state.global_tick+=130
	m.statuses.resolve_time_boundary(m.resolver)
	check(not m.statuses.has(0,"fleet_step") and a.stats.charge_speed==100 and a.gauge==4200,"expiry refreshes CTB speed without losing accrued gauge")
	check(m.statuses.add(0,"sword_flow"),"state can wait for an attack event")
	m.resolver.emit("ATTACK_HIT",{"actor_id":0,"target_id":1})
	check(not m.statuses.has(0,"sword_flow") and m.statuses.has(0,"focused_stance"),"linked transition consumes old state and grants next")
	check(a.stats.attack==12,"event-linked state grants attack modifier")
	m.statuses.remove(0,"focused_stance")
	check(a.stats.attack==10,"removal restores attack score")
	check(m.statuses.add(0,"meridian_open"),"persistent cultivation buff applies")
	check(a.max_qi_u==70000 and a.stats.qi_regen_u_per_100>30000,"persistent buff changes derived qi statistics")
	var exported: Dictionary=m.statuses.export_persistent(0)
	check(exported.has("meridian_open") and not exported.has("sword_flow"),"only character-scoped permanent states export")
	var repeat=Model.new()
	repeat.reset(2026,0,"tingfeng",{"persistent_states":{0:exported}})
	check(repeat.state.outcome=="playing" and repeat.state.get_actor(0).max_qi_u==70000,"permanent buff imports into next encounter")
	var invalid=Model.new()
	invalid.reset(2026,0,"tingfeng",{"persistent_states":{0:{"sword_flow":{"stacks":1}}}})
	check(invalid.state.outcome!="playing","battle-only state cannot persist")
	# Long-term growth: base ceiling derives from trained attributes.
	var char_progress=m.character_progress
	check(char_progress.earn(a,3,30),"earn permanent training points")
	check(char_progress.allocate(a,"CON",2,m.attributes,m.statuses),"allocate two constitution points")
	check(a.attributes.CON==12 and a.base_max_hp_u==220000 and a.max_hp_u==220000,"growth increases innate HP ceiling")
	check(a.hp_u==90000,"training does not magically heal current HP")
	check(not char_progress.allocate(a,"STR",2,m.attributes,m.statuses),"cannot overspend attribute points")
	var grown: Dictionary=char_progress.export_record(a)
	var loaded=Model.new()
	loaded.reset(2026,0,"tingfeng",{"character_progressions":{0:grown}})
	check(loaded.state.outcome=="playing" and loaded.state.get_actor(0).base_max_hp_u==220000,"permanent growth survives battle reset")
	var graph=Model.new()
	graph.reset(2026,0,"tingfeng",{"technique_catalog_path":"res://checks/fixtures/technique_graph.json","techniques":{0:{"test_chain":1}}})
	check(graph.state.outcome=="playing","graph loads into unified state runtime")
	var user=graph.state.get_actor(0)
	check(graph.statuses.has(0,"technique:test_chain"),"technique state lives in unified state storage")
	check(not graph.snapshot(1).actors[0].statuses.has("technique:test_chain"),"private stage hidden from opponents")
	check(graph.martial_progress.award(user,"test_chain",50),"ability proficiency increases")
	check(graph.martial_progress.can_breakthrough(user,"test_chain"),"rank threshold enables breakthrough")
	check(graph.martial_progress.breakthrough(user,"test_chain"),"breakthrough raises technique rank")
	check(user.technique_states.test_chain.rank==2,"unlocked rank propagates to combat stage")
	check(not graph.martial_progress.breakthrough(user,"test_chain"),"breakthrough cannot skip experience threshold")
	var session=Session.new()
	root.add_child(session)
	session.start_new_game()
	session.record_story_event("obtain_fragment")
	check(session.study_fragment(),"study unlocks martial progression record")
	check(session.begin_encounter(),"story starts battle with records")
	var story_battle=Model.new()
	story_battle.reset(session.encounter_seed(),0,"tingfeng",session.encounter_options())
	check(story_battle.state.outcome=="playing","progression is valid in narrative 3v3 encounter")
	var hero=story_battle.state.get_actor(0)
	check(hero.martial_progress.has("taixu"),"learned scroll persists as discipline")
	check(story_battle.martial_progress.award(hero,"taixu",8),"card use can award mastery XP")
	session.capture_battle_progress(story_battle)
	check(session.martial_records[0].taixu.xp==8,"martial XP returns to game session")
	check(session.report_battle("victory",0),"victory awards training")
	check(session.allocate_training_point("STR"),"story progression can spend permanent point")
	check(session.breakthrough_taixu(),"battle training unlocks rank two")
	check(session.character_records[0].growth.STR==1 and session.martial_records[0].taixu.rank==2,"character and martial growth persist together")
	print("UNIFIED STATE PROGRESSION: ",failures," failures")
	session.queue_free()
	quit(1 if failures>0 else 0)
