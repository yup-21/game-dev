[gd_resource type="Resource" script_class="WuxiaTechniqueDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/content/technique_definition.gd" id="1_tech"]
[ext_resource type="Script" path="res://scripts/content/technique_node_definition.gd" id="2_node"]
[ext_resource type="Script" path="res://scripts/content/effect_definition.gd" id="3_effect"]

[sub_resource type="Resource" id="Resource_shield"]
script = ExtResource("3_effect")
effect_type = "add_shield"
target = "self"
amount = 1.0
parameters = {"expires_after_global_ticks": 100}

[sub_resource type="Resource" id="Resource_guard"]
script = ExtResource("2_node")
node_id = "guard"
stage = "guard"
next_node = "guard"
timing = "ACTION"
cost_qi = 1
target_kind = "self"
effects = Array[Resource]([SubResource("Resource_shield")])

[resource]
script = ExtResource("1_tech")
content_id = "r20_guard_stage"
entry_node = "guard"
nodes = Array[Resource]([SubResource("Resource_guard")])
