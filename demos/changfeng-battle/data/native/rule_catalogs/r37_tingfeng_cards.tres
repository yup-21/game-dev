[resource]
script = ExtResource("1")
content_id = "r37_tingfeng_cards"
catalog_type = "tingfeng"
original_schema = "2.0-five-forms"
statuses = Array[Resource]([SubResource("R0001"), SubResource("R0002")])
cards = Array[Resource]([SubResource("R0009"), SubResource("R0025"), SubResource("R0034"), SubResource("R0051"), SubResource("R0064"), SubResource("R0070")])
combos = Array[Resource]([SubResource("R0074"), SubResource("R0077"), SubResource("R0079")])
implementation_status = "condensed_prototype"
meta = {"name":"听风五式：核心机制验证","notes":"探锋式只有试探一个基础用法，攻击后生成一次性「追风」衍生卡；变锋式另由武学阶段状态启用为攻守应变分支，不进入任何牌堆。"}
rules = {"system":"CTB_ACTION_CLASH","base_attributes":{"STR":10,"AGI":10,"CON":10,"MND":10},"initial":{"hp":20,"qi":3,"max_qi":6,"charge_speed":100,"move_budget":2,"hand_size":5,"all_actors_ready_at_global_tick_zero":true,"first_action_does_not_redraw":true},"charge_threshold":10000,"base_qi_regen_per_100_ticks":3,"response_time_advances_global_ticks":false,"action":{"format":"ACTION_START -> ACTION -> ACTION_END","normal_move_qi_per_tile":1,"basic_attack":{"cost_qi":1,"damage":1,"once_per_action":true},"basic_guard":{"cost_qi":1,"shield":1,"once_per_action":true},"discard_for_qi":{"discard_count":1,"gain_qi":1,"once_per_action":true},"keep_hand_through_opponents_actions":true,"replace_unspent_hand_at_next_own_action_start":true},"chain":{"initial_priority":"DEFENDER","max_responses_per_actor":2,"max_total_responses":4,"resolution":"LIFO","resolution_starts_after":"TWO_CONSECUTIVE_PASSES_OR_NO_LEGAL_RESPONSES","no_new_response_during_resolution":true,"root_attack_not_cancelable_by_counter_response":true},"intel":{"passive_insight_ranks":{"0":"危险警报","1":"每次敌方换手牌自动识破一张","2":"每次敌方换手牌自动识破全部"},"passive_conceal_ranks":{"0":"无遮蔽","1":"封锁同级及以下观势、遮蔽危险预警","2":"封锁两级观势、遮蔽危险预警"},"passive_resolution":"insight_rank>conceal_rank can reveal; otherwise conceal wins on tie","exposed_status_overrides_passive_conceal":true,"prior_known_card_uid_persists_until_leaving_hand":true,"ai_must_use_filtered_view":true,"danger_is_high_card_in_current_hand_not_predicted_intention":true},"versions":{"older_interactive_five_phases":"deprecated_in_test_mode","old_on_draw_qi_gain":"deprecated_in_test_mode"}}
deck = SubResource("R0084")
passive_skills = Array[Resource]([SubResource("R0085"), SubResource("R0086")])

