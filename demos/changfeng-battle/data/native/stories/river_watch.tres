[gd_resource type="Resource" script_class="WuxiaStoryDefinition" load_steps=22 format=3]

[ext_resource type="Script" path="res://scripts/content/story_definition.gd" id="story"]
[ext_resource type="Script" path="res://scripts/content/story_beat_definition.gd" id="beat"]
[ext_resource type="Script" path="res://scripts/content/story_event_definition.gd" id="event"]
[ext_resource type="Script" path="res://scripts/content/dialogue_node_definition.gd" id="node"]
