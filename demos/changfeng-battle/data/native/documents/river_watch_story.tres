[gd_resource type="Resource" script_class="WuxiaDataDocument" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/content/data_document.gd" id="1_document"]

[resource]
script = ExtResource("1_document")
content_id = "r25_river_watch_story"
data = {"schema_version":1,"id":"river_watch","title":"夜渡传书","subtitle":"第二幕 · 断桥灯火，暗影相随","cinematic":[{"caption":"断桥 · 四更","text":"雨势稍歇，六人踏过残桥，河谷中有微弱灯火闪烁。","duration":2.6},{"caption":"渡口来客","text":"青衣信使拦下众人，袖中露出一枚染血的镖局铜牌。","duration":2.6}],"entry_node":"river_intro","dialogues":[{"id":"river_intro","speaker":"旁白","text":"河水拍打桥墩，一名信使在乱石旁等候。","events":[{"type":"set_flag","flag":"met_messenger","value":true}],"next":"river_warning"},{"id":"river_warning","speaker":"河渡信使","text":"老镖头的信到了。你们护住的残篇，还有半卷在河谷。","next":"river_choice"},{"id":"river_choice","speaker":"河渡信使","text":"他可曾说过追兵来历？要拿到另一半残篇，须先过桥。","choices":[{"text":"他伤重仍托付于我，我会守诺。","requires":[{"flag":"helped_escort","equals":true}],"events":[{"type":"set_flag","flag":"messenger_trust","value":true}],"next":"river_reward"},{"text":"先谈桥头埋伏与退路。","events":[{"type":"set_flag","flag":"scouted_bridge","value":true}],"next":"river_reward"}]},{"id":"river_reward","speaker":"河渡信使","text":"这颗回气丹留给你。渡口有埋伏，莫轻敌。","events":[{"type":"grant_item","character_id":"shen_changfeng","item_id":"breath_pill","count":1}],"next":"river_oath"},{"id":"river_oath","speaker":"沈长风","text":"信我收下了。暗哨既已露面，便从断桥杀出一条路。","next":"river_finale"},{"id":"river_finale","speaker":"旁白","text":"河谷的火光逐渐逼近。众人拔剑，第二场交锋一触即发。","next":""}]}
